map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT} default_server;
    server_name ${SERVER_NAME};

    client_max_body_size 0;

    # API + static assets + Socket.IO -> backend (NestJS, port 3000)
    location ~ ^/(api|assets|socket\.io)/ {
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${NGINX_X_FORWARDED_PROTO};
        proxy_http_version 1.1;
        proxy_read_timeout 36000s;
        proxy_pass_header Authorization;
        proxy_pass http://backend:3000;
    }

    # Everything else (SPA + Vite HMR websocket) -> frontend (Vite dev server, port 5173)
    location / {
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto ${NGINX_X_FORWARDED_PROTO};
        proxy_http_version 1.1;
        proxy_read_timeout 36000s;
        proxy_pass http://frontend:5173;
    }

    include includes/location_common.conf;
}
