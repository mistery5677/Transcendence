JWT_SECRET=change-me-to-a-random-64-char-hex-string

# --- DB / ports / runtime (added for Phase 1 runtime verification) ---
POSTGRES_USER=insert-your-own-PostgreSQL username
POSTGRES_PASSWORD=insert-your-own-db-password
POSTGRES_DB=insert-your-own-transcendence_db-password
DATABASE_URL=postgresql://user:password@database:5432/dbname?schema=public
BACKEND_PORT=3000
FRONTEND_PORT=5173
NODE_ENV=development

# --- HashiCorp Vault (Phase 2) ---
VAULT_ROOT_TOKEN=change-me-vault-root-token
# Least-privilege token the backend uses (read-only on secret/backend/*); created by vault-init.
VAULT_BACKEND_TOKEN=change-me-vault-backend-token

# --- Nginx + ModSecurity WAF (Phase 3) ---
WAF_PORT=8080
WAF_SSL_PORT=8443